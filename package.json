{
    "name": "c8osdkjscore",
    "version": "4.0.26-beta1",
    "description": "convertigo's sdk js core",
    "main": "bundle/index.umd.js",
    "module": "src/index.js",
    "typings": "src/index.d.ts",
    "files": [
        "src/",
        "LICENCE",
        "tsconfig.json"
    ],
    "scripts": {
        "clean": "rimraf bundles coverage src/c8o/*.d.ts src/c8o/*.metadata.json src/c8o/*.js src/c8o/*.js.map src/c8o/*.ngsummary.json src/*.d.ts src/*.metadata.json src/*.js src/*.js.map src/*.ngsummary.json",
        "prepare": "npm run clean && tsc -p . && npm run build",
        "build": "webpack && cp bundles/index.umd.js bundles/index.js",
        "build-dev": "tsc -p ."
    },
    "keywords": [
        "MBaaS",
        "TypeScript",
        "JavaScript",
        "Convertigo",
        "mbaas",
        "madp",
        "mobility",
        "nosql",
        "couchdb"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/convertigo/c8osdk-js-core"
    },
    "author": {
        "name": "Convertigo",
        "email": "info@convertigo.com",
        "url": "http://www.convertigo.com/"
    },
    "license": "Apache License Version 2.0, January 2004",
    "peerDependencies": {
        "rxjs": "^7.8.2"
    },
    "dependencies": {
        "@types/node": "^20.19.0",
        "@types/pouchdb": "6.4.0",
        "@types/pouchdb-core": "7.0.6",
        "lodash": "4.17.21",
        "pouchdb-browser": "7.2.2",
        "pouchdb-checkpointer": "7.2.2",
        "pouchdb-extend": "0.1.2",
        "pouchdb-find": "7.2.2",
        "pouchdb-generate-replication-id": "7.2.2",
        "pouchdb-quick-search-convertigo": "1.3.1",
        "rxjs": "^7.8.2",
        "worker-pouch": "2.1.0",
        "zone.js": "~0.16.0"
    },
    "devDependencies": {
        "@types/jasmine": "^5.1.0",
        "@types/lodash": "4.14.161",
        "jasmine-core": "^5.13.0",
        "karma": "^6.4.4",
        "karma-chrome-launcher": "^3.2.0",
        "karma-coverage": "^2.2.1",
        "karma-jasmine": "^5.1.0",
        "karma-mocha-reporter": "^2.2.5",
        "karma-sourcemap-loader": "^0.3.8",
        "rimraf": "^5.0.5",
        "ts-loader": "^9.5.1",
        "typescript": "5.9.3",
        "webpack": "^5.96.0",
        "webpack-cli": "^5.1.4"
    }
}
